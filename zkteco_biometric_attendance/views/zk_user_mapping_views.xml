<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zk_user_mapping_list" model="ir.ui.view">
        <field name="name">zk.user.mapping.list</field>
        <field name="model">zk.user.mapping</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="device_id"/>
                <field name="device_user_id"/>
                <field name="device_user_name"/>
                <field name="employee_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_zk_user_mapping" model="ir.actions.act_window">
        <field name="name">Device User Mappings</field>
        <field name="res_model">zk.user.mapping</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Map device users to employees</p>
            <p>One employee can have a different device user id on every device
               — add one row per (device, employee) pair.</p>
        </field>
    </record>
</odoo>
