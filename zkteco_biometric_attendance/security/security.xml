<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_zk_attendance" model="ir.module.category">
        <field name="name">ZK Attendance</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_zk_attendance" model="res.groups.privilege">
        <field name="name">ZK Attendance Access</field>
        <field name="category_id" ref="module_category_zk_attendance"/>
    </record>

    <record id="group_zk_attendance_user" model="res.groups">
        <field name="name">User: view devices &amp; logs</field>
        <field name="privilege_id" ref="privilege_zk_attendance"/>
    </record>

    <record id="group_zk_attendance_manager" model="res.groups">
        <field name="name">Manager: configure devices &amp; mappings</field>
        <field name="privilege_id" ref="privilege_zk_attendance"/>
        <field name="implied_ids" eval="[(4, ref('group_zk_attendance_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="zk_device_company_rule" model="ir.rule">
        <field name="name">ZK Device: multi-company</field>
        <field name="model_id" ref="model_zk_device"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
