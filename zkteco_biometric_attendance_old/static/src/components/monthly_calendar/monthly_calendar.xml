<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="smr_zk_attendace.MonthlyCalendar" owl="1">
        <div class="smr-mc-dashboard o_action">
            <t t-if="state.loading">
                <div class="text-center p-5">
                    <i class="fa fa-spinner fa-spin fa-3x text-primary"/>
                    <h3 class="mt-3">Loading Calendar...</h3>
                </div>
            </t>
            <t t-else="">
                <!-- Header -->
                <div class="smr-mc-header">
                    <div class="smr-mc-brand">
                        <i class="fa fa-calendar-check-o smr-mc-brand-icon"/>
                        <div>
                            <h2>Monthly Attendance Calendar</h2>
                            <p class="smr-mc-subtitle">Real-time workforce insights &amp; performance metrics</p>
                        </div>
                    </div>
                </div>

                <!-- Filters -->
                <div class="smr-mc-filters">
                    <div class="smr-mc-filter-group">
                        <i class="fa fa-filter smr-mc-filter-icon"/>
                        <span class="smr-mc-filter-label">FILTERS</span>
                        <select class="smr-mc-select" t-on-change="onDeptChange">
                            <option value="">All Departments</option>
                            <t t-foreach="state.data.departments" t-as="dept" t-key="dept.id">
                                <option t-att-value="dept.id" t-att-selected="state.department_id === dept.id">
                                    <t t-esc="dept.name"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <!-- Month Nav -->
                    <div class="smr-mc-nav-group">
                        <button class="btn btn-sm smr-mc-prev" title="Previous Month" t-on-click="onPrevMonth">
                            <i class="fa fa-chevron-left"/>
                        </button>
                        <span class="smr-mc-month-label" t-esc="state.data.month_name"/>
                        <button class="btn btn-sm smr-mc-next" title="Next Month" t-on-click="onNextMonth">
                            <i class="fa fa-chevron-right"/>
                        </button>
                        <button class="btn btn-sm btn-outline-primary smr-mc-today" t-on-click="onToday">Today</button>
                    </div>
                    
                    <div class="smr-mc-emp-badge">
                        <span class="smr-mc-emp-count"><t t-esc="state.data.total_employees"/> Employees</span>
                    </div>
                </div>

                <!-- Tabs -->
                <div class="smr-mc-tabs">
                    <button t-attf-class="smr-mc-tab {{ state.activeTab === 'today' ? 'active' : '' }}" t-on-click="() => this.onTabClick('today')">
                        <i class="fa fa-clock-o"/> Today
                    </button>
                    <button t-attf-class="smr-mc-tab {{ state.activeTab === 'attendance' ? 'active' : '' }}" t-on-click="() => this.onTabClick('attendance')">
                        <i class="fa fa-calendar"/> Attendance
                    </button>
                    <button t-attf-class="smr-mc-tab {{ state.activeTab === 'leaves' ? 'active' : '' }}" t-on-click="() => this.onTabClick('leaves')">
                        <i class="fa fa-plane"/> Leaves
                    </button>
                </div>

                <!-- Calendar Grid -->
                <t t-if="state.activeTab === 'attendance'">
                    <!-- Legend -->
                    <div class="smr-mc-legend">
                        <div class="smr-mc-legend-items">
                            <span class="smr-mc-legend-item"><span class="smr-mc-legend-dot smr-mc-dot-present"/> Present (P) - Hours</span>
                            <span class="smr-mc-legend-item"><span class="smr-mc-legend-dot smr-mc-dot-absent"/> Absent (A)</span>
                            <span class="smr-mc-legend-item"><span class="smr-mc-legend-dot smr-mc-dot-leave"/> Leave (L)</span>
                            <span class="smr-mc-legend-item"><span class="smr-mc-legend-dot smr-mc-dot-weekend"/> Weekend (W)</span>
                        </div>
                    </div>

                    <div class="smr-mc-table-container">
                        <table class="smr-mc-table">
                        <thead>
                            <tr>
                                <th class="smr-mc-th-emp sticky-col">Employee</th>
                                <t t-foreach="state.data.day_headers" t-as="dh" t-key="dh.day">
                                    <th t-attf-class="smr-mc-th-day {{ dh.is_weekend ? 'smr-mc-weekend' : '' }}">
                                        <div class="smr-mc-day-head">
                                            <span class="smr-mc-day-name" t-esc="dh.weekday"/>
                                            <span class="smr-mc-day-num" t-esc="dh.day"/>
                                        </div>
                                    </th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="state.data.employees.length === 0">
                                <tr>
                                    <td t-att-colspan="state.data.day_headers.length + 1" class="text-center p-5 text-muted">
                                        No employees found in this department.
                                    </td>
                                </tr>
                            </t>
                            <t t-foreach="state.data.employees" t-as="emp" t-key="emp.id">
                                <tr>
                                    <td class="smr-mc-td-emp sticky-col">
                                        <div class="smr-mc-emp-info">
                                            <span class="smr-mc-emp-avatar" t-esc="emp.name.charAt(0)"/>
                                            <div class="smr-mc-emp-details">
                                                <span class="smr-mc-emp-name" t-esc="emp.name"/>
                                                <span class="smr-mc-emp-dept" t-esc="emp.department"/>
                                            </div>
                                        </div>
                                    </td>
                                    <t t-foreach="emp.days" t-as="cell" t-key="cell.date">
                                        <td t-attf-class="smr-mc-td-day {{ cell.status === 'W' ? 'smr-mc-weekend' : '' }}">
                                            <t t-if="cell.status === 'P'">
                                                <div class="smr-mc-cell smr-mc-present">
                                                    <span t-esc="(cell.worked_hours || 0).toFixed(1)"/>
                                                </div>
                                            </t>
                                            <t t-elif="cell.status === 'A'">
                                                <div class="smr-mc-cell smr-mc-absent">
                                                    <span>A</span>
                                                </div>
                                            </t>
                                            <t t-elif="cell.status === 'L'">
                                                <div class="smr-mc-cell smr-mc-leave" t-att-title="cell.tooltip">
                                                    <span>L</span>
                                                </div>
                                            </t>
                                            <t t-elif="cell.status === 'W'">
                                                <div class="smr-mc-cell smr-mc-weekend">
                                                    <span>W</span>
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <div class="smr-mc-cell smr-mc-empty"/>
                                            </t>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    </div>
                </t>
                <t t-elif="state.activeTab === 'today'">
                    <div class="smr-mc-table-container">
                        <t t-set="today_iso" t-value="this.todayIso"/>
                        <t t-set="today_header" t-value="state.data.day_headers.find(dh => dh.date === today_iso)"/>
                        
                        <t t-if="!today_header">
                            <div class="text-center p-5 text-muted">
                                <h3>Today's date is not in the currently selected month.</h3>
                                <button class="btn btn-primary mt-3" t-on-click="onToday">Switch to Current Month</button>
                            </div>
                        </t>
                        <t t-else="">
                            <table class="table table-striped table-hover align-middle border mt-3">
                                <thead class="table-light">
                                    <tr>
                                        <th class="sticky-col">Employee</th>
                                        <th>Department</th>
                                        <th>Status</th>
                                        <th>Hours Worked</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="state.data.employees.length === 0">
                                        <tr>
                                            <td colspan="5" class="text-center p-5 text-muted">
                                                No employees found in this department.
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-foreach="state.data.employees" t-as="emp" t-key="emp.id">
                                        <t t-set="today_cell" t-value="emp.days.find(c => c.date === today_iso)"/>
                                        <tr>
                                            <td class="sticky-col font-weight-bold" t-esc="emp.name"/>
                                            <td t-esc="emp.department"/>
                                            <td>
                                                <t t-if="today_cell.status === 'P'"><span class="badge rounded-pill text-bg-success">Present</span></t>
                                                <t t-elif="today_cell.status === 'A'"><span class="badge rounded-pill text-bg-danger">Absent</span></t>
                                                <t t-elif="today_cell.status === 'L'"><span class="badge rounded-pill text-bg-info">Leave</span></t>
                                                <t t-elif="today_cell.status === 'W'"><span class="badge rounded-pill text-bg-secondary">Weekend</span></t>
                                                <t t-else="">-</t>
                                            </td>
                                            <td class="font-weight-bold" t-esc="today_cell.status === 'P' ? (today_cell.worked_hours || 0).toFixed(1) : ''"/>
                                            <td class="text-muted" t-esc="today_cell.tooltip || ''"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
                <t t-elif="state.activeTab === 'leaves'">
                    <div class="smr-mc-table-container mt-3 px-3">
                        <table class="table table-striped table-hover align-middle border">
                            <thead class="table-light">
                                <tr>
                                    <th class="sticky-col">Employee</th>
                                    <th>Department</th>
                                    <th>Leave Days</th>
                                    <t t-foreach="state.data.leave_types" t-as="ltype" t-key="ltype.code">
                                        <th t-att-title="ltype.name" t-esc="ltype.code"/>
                                    </t>
                                    <th>Holiday Days</th>
                                    <th>Weekend Days</th>
                                    <th>Total Off Days</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="state.data.employees.length === 0">
                                    <tr>
                                        <td t-att-colspan="6 + state.data.leave_types.length" class="text-center p-5 text-muted">
                                            No employees found in this department.
                                        </td>
                                    </tr>
                                </t>
                                <t t-foreach="state.data.employees" t-as="emp" t-key="emp.id">
                                    <tr>
                                        <td class="sticky-col" t-esc="emp.name"/>
                                        <td t-esc="emp.department"/>
                                        <td class="text-info font-weight-bold" t-esc="emp.summary.leave"/>
                                        <t t-foreach="state.data.leave_types" t-as="ltype" t-key="ltype.code">
                                            <td t-esc="emp.leave_days[ltype.code] || ''"/>
                                        </t>
                                        <td class="text-primary font-weight-bold" t-esc="emp.summary.holiday"/>
                                        <td t-esc="emp.summary.weekend"/>
                                        <td class="font-weight-bold" t-esc="emp.summary.leave + emp.summary.holiday + emp.summary.weekend"/>
                                    </tr>
                                </t>
                            </tbody>
                            <t t-if="state.data.totals">
                                <tfoot>
                                    <tr class="smr-mc-total-row font-weight-bold bg-light">
                                        <td class="sticky-col">TOTAL</td>
                                        <td t-esc="state.data.totals.employees + ' employees'"/>
                                        <td t-esc="state.data.totals.leave"/>
                                        <t t-foreach="state.data.leave_types" t-as="ltype" t-key="ltype.code">
                                            <td t-esc="state.data.totals.leave_days[ltype.code] || ''"/>
                                        </t>
                                        <td t-esc="state.data.totals.holiday"/>
                                        <td t-esc="state.data.totals.weekend"/>
                                        <td t-esc="state.data.totals.leave + state.data.totals.holiday + state.data.totals.weekend"/>
                                    </tr>
                                </tfoot>
                            </t>
                        </table>
                    </div>
                </t>
            </t>
        </div>
    </t>
</templates>
