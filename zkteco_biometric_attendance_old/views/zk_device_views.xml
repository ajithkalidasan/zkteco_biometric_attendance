<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zk_device_list" model="ir.ui.view">
        <field name="name">zk.device.list</field>
        <field name="model">zk.device</field>
        <field name="arch" type="xml">
            <list decoration-danger="state=='offline'" decoration-success="state=='online'">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="connection_mode"/>
                <field name="device_ip"/>
                <field name="tz"/>
                <field name="state" widget="badge"/>
                <field name="last_sync"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_zk_device_form" model="ir.ui.view">
        <field name="name">zk.device.form</field>
        <field name="model">zk.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection"
                            class="btn-primary"/>
                    <button name="action_download_attendance" type="object" string="Sync Now"
                            class="btn-secondary" invisible="connection_mode == 'adms'"/>
                    <button name="action_clear_device_attendance" type="object" string="Clear Device Log"
                            confirm="This wipes the punch log stored ON THE DEVICE ITSELF. Odoo's copy in zk.attendance.log is not affected. Continue?"
                            invisible="connection_mode == 'adms'"/>
                    <button name="action_queue_reboot" type="object" string="Queue Reboot"
                            invisible="connection_mode == 'pyzk'"/>
                    <button name="action_queue_clear_attendance" type="object" string="Queue Clear Log"
                            invisible="connection_mode == 'pyzk'"/>
                    <field name="state" widget="statusbar" statusbar_visible="unknown,online,offline"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_user_mappings" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="user_mapping_count" widget="statinfo" string="Mapped Users"/>
                        </button>
                        <button name="action_view_attendance_logs" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="attendance_log_count" widget="statinfo" string="Raw Logs"/>
                        </button>
                        <button name="action_view_commands" type="object" class="oe_stat_button" icon="fa-terminal"
                                invisible="connection_mode == 'pyzk'">
                            <field name="command_pending_count" widget="statinfo" string="Pending Commands"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Main Entrance"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="serial_number"/>
                            <field name="tz"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Transport">
                            <field name="connection_mode" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="PyZK (Direct)" invisible="connection_mode == 'adms'">
                            <group>
                                <group>
                                    <field name="device_ip"/>
                                    <field name="device_port"/>
                                    <field name="zk_password"/>
                                </group>
                                <group>
                                    <field name="zk_timeout"/>
                                    <field name="zk_force_udp" widget="boolean_toggle"/>
                                    <field name="zk_ommit_ping" widget="boolean_toggle"/>
                                </group>
                            </group>
                            <group string="Status">
                                <field name="last_connection"/>
                                <field name="last_sync"/>
                                <field name="last_sync_count"/>
                            </group>
                        </page>
                        <page string="ADMS (Cloud Push)" invisible="connection_mode == 'pyzk'">
                            <group>
                                <field name="adms_enabled" widget="boolean_toggle"/>
                                <field name="adms_url" readonly="1" widget="CopyClipboardChar"/>
                                <field name="adms_last_heartbeat"/>
                                <field name="adms_push_version"/>
                                <field name="adms_firmware"/>
                            </group>
                            <div class="alert alert-info alert-dismissible" role="alert">
                                <i class="fa fa-info-circle me-1"/>
                                Paste the <strong>ADMS Push URL</strong> above into the device's
                                <em>Comm → Cloud Server Setting</em> menu as the Server Address,
                                or split it into host/port/path per your firmware's fields.
                            </div>
                        </page>
                        <page string="Errors" invisible="not last_error">
                            <field name="last_error" readonly="1"/>
                        </page>
                        <page string="Command Queue" invisible="connection_mode == 'pyzk'">
                            <field name="command_ids" readonly="1">
                                <list decoration-muted="state=='pending'" decoration-success="state=='done'"
                                      decoration-danger="state=='failed'" decoration-info="state=='sent'">
                                    <field name="command_id"/>
                                    <field name="command_type"/>
                                    <field name="command_text"/>
                                    <field name="state" widget="badge"/>
                                    <field name="sent_date"/>
                                    <field name="done_date"/>
                                    <field name="result_code"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_zk_device_search" model="ir.ui.view">
        <field name="name">zk.device.search</field>
        <field name="model">zk.device</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="serial_number"/>
                <field name="device_ip"/>
                <filter string="PyZK" name="filter_pyzk" domain="[('connection_mode','=','pyzk')]"/>
                <filter string="ADMS" name="filter_adms" domain="[('connection_mode','=','adms')]"/>
                <filter string="Hybrid" name="filter_hybrid" domain="[('connection_mode','=','hybrid')]"/>
                <separator/>
                <filter string="Online" name="filter_online" domain="[('state','=','online')]"/>
                <filter string="Offline" name="filter_offline" domain="[('state','=','offline')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                <group>
                    <filter string="Transport" name="group_transport" context="{'group_by': 'connection_mode'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_zk_device" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="res_model">zk.device</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_zk_device_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first ZK biometric device</p>
            <p>Choose PyZK if Odoo can reach the device's IP directly, ADMS if the
               device pushes over the internet, or Hybrid to get both.</p>
        </field>
    </record>
</odoo>
