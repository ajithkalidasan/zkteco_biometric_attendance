<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zk_device_sync_wizard_form" model="ir.ui.view">
        <field name="name">zk.device.sync.wizard.form</field>
        <field name="model">zk.device.sync.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="device_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_sync_now" type="object" string="Sync Now" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_zk_device_sync_wizard" model="ir.actions.act_window">
        <field name="name">Sync Devices Now</field>
        <field name="res_model">zk.device.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
